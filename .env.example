# Скопируйте этот файл в .env и заполните значения.
# Файл .env содержит пароли, поэтому он не добавляется в Git.

# Учётная запись администратора Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=ChangeMe_2026

# Адрес публичного Git-репозитория с этим проектом
REPO_URL=https://github.com/your-login/chess-puzzles-ci.git

# (Необязательно) Отправка готового APK в Telegram.
# Оставьте пустыми, если эта функция не нужна.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
